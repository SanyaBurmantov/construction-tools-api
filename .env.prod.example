DOMAIN=example.com
PUBLIC_ORIGIN=https://example.com

DB_USER=postgres
DB_PASSWORD=change-this-long-random-password
DB_NAME=construction_tools

# Prisma connection pool. The default (CPU*2+1 = 5 here) is too small for this
# app's query fan-out — raise it rather than letting requests time out waiting.
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=20

ADMIN_TOKEN=change-this-long-random-admin-token

# --- Accounts / admin sign-in ---
# On first boot, if there is no active ADMIN account, one is created with this
# login and ADMIN_PASSWORD. Leave ADMIN_PASSWORD empty and the committed
# initial password is used instead, so the first login is always known:
# admin / test-111 — change it in /admin/users right after signing in.
# Nothing here ever overwrites an account that already exists.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# How long an account session (Authorization: Bearer) stays valid.
AUTH_SESSION_TTL_DAYS=30
# How long an untouched account cart is kept before the nightly cleanup drops it.
CART_TTL_DAYS=90
# How long untouched favourites/comparison rows are kept.
LIST_TTL_DAYS=365
# How long the admin action log is kept.
ADMIN_LOG_TTL_DAYS=180

# EVERYTHING below is a first-boot default only. All of it — switches, batch
# sizes, request delays, page caps and category filters — is editable in
# /admin/parsing, and a value saved there wins over the variable here for good.
# Change these only to set up a fresh install; day to day, use the admin.
PARSER_CRON_ENABLED=false
# Alert when this share of available prices exceeds the maximum age.
PARSER_PRICE_MAX_AGE_HOURS=48
PARSER_PRICE_STALE_PERCENT=10
# Per-source switches, same rule: default here, override in the admin.
TH_TOOLS_CRON_ENABLED=true
DUKON_CRON_ENABLED=true
# Hard timeout (ms) for every parser HTTP request; a hung fetch would stall a cron.
PARSER_FETCH_TIMEOUT_MS=20000
# Доля упавших URL в прогоне, выше которой задание считается сломанным.
PARSER_FAILURE_RATE_THRESHOLD=0.5
# Сторож возвращает упавшие URL в очередь: не раньше N минут и не больше N попыток.
PARSER_RETRY_AFTER_MINUTES=60
PARSER_MAX_ATTEMPTS=3
DUKON_CRON_BATCH_LIMIT=30
DUKON_DISCOVERY_MAX_PAGES=5000

# --- th-tool.by ---
# URLs per cron run (every 30 min). 30 × 48 = 1440/сутки, а в очереди ~39k —
# то есть месяц на первый залив. Поднимите здесь или в /admin/parsing.
TH_TOOLS_CRON_BATCH_LIMIT=300
# Pause between product requests. th-tool.by has ~39k products, so the queue is
# drained over days regardless — there is nothing to gain by hurrying it.
TH_TOOLS_REQUEST_DELAY_MS=1500
# Safety cap when walking a category's pagination.
TH_TOOLS_CATEGORY_MAX_PAGES=100
# Categories crawled per run of the hourly category job. Pending categories
# divided by this is how many hours a full sweep takes — at the old hardcoded 5
# and 591 pending categories that was five days.
TH_TOOLS_CATEGORY_BATCH_LIMIT=20
# Category filter, matched against the breadcrumb chain. Leave INCLUDE empty:
# th-tool.by is already a tool shop, so a whitelist only risks losing sections.
# EXCLUDE drops toiletries, car accessories, bikes and garden/leisure while
# keeping "Аксессуары / Измерительные приборы" and "Аксессуары / Спецодежда,
# защита" — welding masks and PPE live there. Unset falls back to this default.
TH_TOOLS_CATEGORY_INCLUDE_REGEX=
TH_TOOLS_CATEGORY_EXCLUDE_REGEX=косметика|автохими|автоламп|антенн|ароматизатор|брелок|ковры напольные|кресла детские|очки для чтения|помощь водителю|щ[её]тки стеклоочистител|уход за авто|внешний тюнинг|внутрисалонн|велотехник|дача, отдых

# --- tools.by ---
# Наш поставщик; выгрузку каталога согласовали. Sitemap у сайта нет, поэтому
# «refresh» — это обход каталога, он же находит новые товары.
TOOLS_BY_CRON_ENABLED=true
TOOLS_BY_CRON_BATCH_LIMIT=300
TOOLS_BY_REQUEST_DELAY_MS=2000
# Сколько страниц каталога обходить за один refresh.
TOOLS_BY_DISCOVERY_MAX_PAGES=2000
# Catalog responses may be slow; product requests keep PARSER_FETCH_TIMEOUT_MS.
TOOLS_BY_CATALOG_FETCH_TIMEOUT_MS=60000
# tools.by — сам по себе магазин инструмента, INCLUDE не нужен. EXCLUDE убирает
# хозтовары и прочее, что агрегатору стройинструмента не нужно; точечно
# категории выключаются галочками в /admin/parsing.
TOOLS_BY_CATEGORY_INCLUDE_REGEX=
TOOLS_BY_CATEGORY_EXCLUDE_REGEX=товары для дома|товары для уборки|посуда|текстиль|игрушк|канцеляр|зоотовар|космет|бытовая химия|продукты питания

# --- 7745.by ---
# NOT a real supplier: it was a sample site from the client and is kept only as
# the reference implementation. Leave the cron off.
SUPPLIER_7745_CRON_ENABLED=false
SUPPLIER_7745_CRON_BATCH_LIMIT=30
SUPPLIER_7745_CATEGORY_INCLUDE_REGEX=запчаст|инструмент|электроинструмент|оснаст|оборудован|строй|строител|отделоч|крепеж|фурнитур|сантех|климат|электрик|спецодеж|сиз|садовая техника|автотовар
SUPPLIER_7745_CATEGORY_EXCLUDE_REGEX=семена|зоотовары|аквариум|кухон|ванн|космет|спорт|единоборств|эпилятор|яйцевар|наушник|гарнитур

SWAGGER_ENABLED=false

# Checkout delivery costs (storefront orders). Defaults: courier 15, post 10, pickup 0.
DELIVERY_COST_COURIER=15
DELIVERY_COST_POST=10

# API hardening. Rate limit = THROTTLE_LIMIT requests per THROTTLE_TTL ms per IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
BODY_LIMIT=1mb
# Reverse-proxy hops to trust for the real client IP (Caddy = 1).
TRUST_PROXY_HOPS=1

# Re-read successful supplier snapshots after this many hours (queue capacity applies).
PARSER_REFRESH_AFTER_HOURS=24
