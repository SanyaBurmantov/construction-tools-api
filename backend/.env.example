# Production Environment Variables
# Copy this file to .env and update values

# Database
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# API
API_PORT=3000

# HTTP/HTTPS
HTTP_PORT=80
HTTPS_PORT=443

# Node
NODE_ENV=production

# Re-read successful supplier snapshots after this many hours (queue capacity applies).
PARSER_REFRESH_AFTER_HOURS=24
