# Production Environment Variables
# Copy this file to .env and update values

# Database
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# API
API_PORT=3000

# HTTP/HTTPS
HTTP_PORT=80
HTTPS_PORT=443

# JWT
JWT_SECRET=CHANGE_THIS_SUPER_SECRET_KEY_IN_PRODUCTION_MIN_32_CHARS
JWT_EXPIRATION=7d

# Node
NODE_ENV=production
