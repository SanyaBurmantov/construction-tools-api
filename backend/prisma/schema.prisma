// prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Category {
  id             String   @id @default(uuid())
  name           String
  /// Public URL segment. Pretty and short where possible, so it is NOT a
  /// reliable identity — two suppliers' branches can both end in "Прочее".
  slug           String   @unique
  /// Identity: the full slug chain from the root ("aksessuary/avtolampy/narva").
  /// Parsers upsert on this, which is what keeps same-named leaves under
  /// different parents from collapsing into one category.
  pathKey        String   @unique
  parentId       String?
  level          Int
  path           String[]
  description    String?
  image          String?
  seoTitle       String
  seoDescription String

  /// Storefront ordering, lowest first. Ties fall back to product count, so
  /// the default 0 keeps the "biggest category first" behaviour until an admin
  /// pins something.
  sortOrder  Int     @default(0)
  /// Hidden categories disappear from every storefront listing (menu, tree,
  /// facets) but stay reachable by URL, so an existing link keeps working
  /// while the branch is being curated.
  isVisible  Boolean @default(true)
  /// Pinned into the home page category grid. With none pinned the grid falls
  /// back to the largest root categories.
  isFeatured Boolean @default(false)

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products               Product[]
  specifications         Specification[]
  mappedSourceCategories SourceCategory[]    @relation("MappedSourceCategory")
  redirects              CategoryRedirect[]
  pricingRules           PricingRule[]
  pathAliases            CategoryPathAlias[]

  @@index([parentId])
  @@index([isVisible, sortOrder])
}

model Brand {
  id             String        @id @default(uuid())
  name           String
  slug           String        @unique
  description    String?
  logo           String?
  country        String?
  seoTitle       String
  seoDescription String
  products       Product[]
  pricingRules   PricingRule[]
  aliases        BrandAlias[]

  /// Search and suggestions match brand names with ILIKE.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Slug of a brand an admin merged into another one. `upsertBrand()` resolves
/// the supplier's spelling through here before creating anything, so the
/// next parse does not resurrect the merged-away brand and pull its products
/// back to it.
model BrandAlias {
  slug    String @id
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// A supplier breadcrumb chain (`pathKey` as the parser computes it) that now
/// lives somewhere else, because an admin moved, re-slugged or merged the
/// category it used to name. `CategoryTreeService.upsertBranch()` resolves
/// through here first, so the next parse finds the category where the admin
/// put it instead of recreating it at the supplier's position.
model CategoryPathAlias {
  pathKey    String   @id
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Specification {
  id               String   @id @default(uuid())
  name             String
  key              String
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  unit             String?
  group            String?
  filterable       Boolean  @default(false)
  /// Set when an admin decided `filterable` by hand (or via auto-select). The
  /// nightly normalizer then leaves the row alone — it used to flip admin
  /// choices back every night.
  filterableLocked Boolean  @default(false)

  /// Source-independent identity of the characteristic, from
  /// `parser/spec-canonical.ts`. Facets group by this, NOT by `id`: `id` is
  /// per-category, so grouping by it put "Вес" in the sidebar once per
  /// subcategory and made the spec filter miss the rest of the subtree.
  /// The unit is part of the key, so `Длина, мм` and `Длина, м` stay apart.
  canonicalKey  String?
  /// Label shown for the whole canonical group. Several rows share a key and
  /// may disagree on spelling; the normalizer picks the most common one.
  canonicalName String?
  /// Unit lifted out of the name, or inferred from the values.
  canonicalUnit String?

  productSpecs ProductSpecification[]

  @@unique([categoryId, key])
  @@index([canonicalKey])
  @@index([canonicalKey, filterable])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

/// Who set a product's current status. SYSTEM statuses are the automation's
/// to change (a new product published once priced, a delisted one hidden and
/// brought back when an offer returns); ADMIN statuses are never touched by a
/// parse.
enum StatusSource {
  SYSTEM
  ADMIN
}

model Product {
  id                    String                 @id @default(uuid())
  slug                  String                 @unique
  name                  String
  brand                 Brand?                 @relation(fields: [brandId], references: [id])
  brandId               String?
  category              Category               @relation(fields: [categoryId], references: [id])
  categoryId            String
  sku                   String?
  barcode               String?
  /// How complete the card is, for the default catalogue order: 2 for a real
  /// photo + 1 for a description (0–3). Recomputed hourly by
  /// ListingRankService; a bare card sinks below the ones a buyer can judge.
  listingRank           Int                    @default(0)
  model                 String?
  images                ProductImage[]
  priceValue            Float?
  priceCurrency         String?
  oldPrice              Float?
  /// Supplier cost the storefront price is derived from.
  costPrice             Float?
  /// AUTO — recomputed from PricingRule on every parse. MANUAL — an admin set
  /// the price by hand and parsing must not overwrite it.
  pricingMode           PricingMode            @default(AUTO)
  appliedRule           PricingRule?           @relation(fields: [appliedRuleId], references: [id])
  appliedRuleId         String?
  /// Set when a cost jump looked like a supplier error; the old price is kept
  /// until an admin confirms.
  priceReviewNeeded     Boolean                @default(false)
  priceHistory          PriceHistory[]
  stockStatus           String?
  stockQuantity         Int?
  status                ProductStatus          @default(PUBLISHED)
  statusSource          StatusSource           @default(SYSTEM)
  descriptionShort      String?
  descriptionFull       String?
  seoTitle              String?
  seoDescription        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  productSpecs          ProductSpecification[]
  sourceProducts        SourceProduct[]
  orderItems            OrderItem[]
  reviews               Review[]
  redirects             ProductRedirect[]
  /// Denormalized aggregate over APPROVED reviews, recomputed on moderation.
  ratingAvg             Float?
  ratingCount           Int                    @default(0)
  /// Normalized dedup keys, rebuilt whenever identity fields change. Matching
  /// looks these up directly instead of re-normalizing the whole catalogue.
  matchBarcode          String?
  /// brand + sku, normalized.
  matchSku              String?
  /// brand + model, normalized.
  matchModel            String?
  /// Text fields an AI task rewrote (`ai/`). Re-parsing leaves these alone —
  /// the daily refresh would otherwise put the supplier's text back within 24h.
  /// Reverting the task item unlocks them again.
  aiLockedFields        String[]               @default([])
  /// Fields an admin edited by hand. Same protection as `aiLockedFields`:
  /// the daily re-parse used to revert a corrected name or category.
  lockedFields          String[]               @default([])
  /// When the page's own text last changed (name, descriptions, SEO, slug) —
  /// the sitemap's `lastmod`. `updatedAt` moves on every daily re-parse, and a
  /// lastmod that is always "today" is one search engines learn to ignore.
  contentUpdatedAt      DateTime               @default(now())
  /// A supplier changed what identifies the product (article, model code,
  /// sizes in its name) while our name is locked: `{ sourceId, url, from, to }`.
  /// Shown in the data-quality panel until an admin saves the product.
  supplierNameChange    Json?
  supplierNameChangedAt DateTime?

  cartItems CartItem[]

  listItems UserListItem[]

  /// Derived relations live in their own table; never included in listings.
  compatibleAccessories ProductCompatibility[] @relation("CompatibleProduct")
  fitsProducts          ProductCompatibility[] @relation("CompatibleAccessory")

  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, priceValue])
  @@index([status, createdAt])
  @@index([status, name])
  @@index([status, listingRank, name])
  @@index([status, ratingAvg])
  @@index([status, updatedAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([appliedRuleId])
  @@index([priceReviewNeeded])
  @@index([matchBarcode])
  @@index([matchSku])
  @@index([matchModel])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  /// Search matches `model` with ILIKE too; without this the OR across
  /// name/sku/model fell back to a sequential scan.
  @@index([model(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// One directed fact, read in both directions: accessory -> compatible product.
/// Fingerprints invalidate the fact immediately when its inputs change, before
/// the worker gets around to rebuilding it. No descriptions are copied here.
model ProductCompatibility {
  accessoryId        String
  productId          String
  accessory          Product  @relation("CompatibleAccessory", fields: [accessoryId], references: [id], onDelete: Cascade)
  product            Product  @relation("CompatibleProduct", fields: [productId], references: [id], onDelete: Cascade)
  accessorySignature String   @db.Char(32)
  productSignature   String   @db.Char(32)
  modelCode          String   @db.VarChar(80)
  evidenceField      String   @db.VarChar(32)
  ruleVersion        Int
  createdAt          DateTime @default(now())

  @@id([accessoryId, productId])
  @@index([productId, accessoryId])
}

model ProductSpecification {
  id              String        @id @default(uuid())
  product         Product       @relation(fields: [productId], references: [id])
  productId       String
  specification   Specification @relation(fields: [specificationId], references: [id])
  specificationId String
  /// As the supplier wrote it, for the product page.
  value           String
  /// What the facets group and filter by: case folded, unit stripped when it
  /// only repeats the specification's own unit, numbers formatted one way.
  /// NULL means "not usable as a filter option" — no data, or a physically
  /// impossible zero such as the `Вес = "0 кг"` that 6188 products carried.
  valueNorm       String?

  @@unique([productId, specificationId])
  @@index([specificationId])
  @@index([specificationId, valueNorm])
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  alt       String?
  order     Int
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@index([productId])
}

model Source {
  id               String           @id @default(uuid())
  name             String
  code             String           @unique
  url              String
  sourceProducts   SourceProduct[]
  sourceCategories SourceCategory[]
  pricingRules     PricingRule[]
}

model SourceCategory {
  id               String           @id @default(uuid())
  source           Source           @relation(fields: [sourceId], references: [id])
  sourceId         String
  externalId       String
  name             String
  slug             String
  url              String?
  parent           SourceCategory?  @relation("SourceCategoryChildren", fields: [parentId], references: [id])
  parentId         String?
  children         SourceCategory[] @relation("SourceCategoryChildren")
  level            Int
  path             String[]
  mappedCategory   Category?        @relation("MappedSourceCategory", fields: [mappedCategoryId], references: [id])
  mappedCategoryId String?
  /// Off means "do not import products from this branch" — checked against the
  /// breadcrumb chain before a product is saved, so it also covers children.
  isEnabled        Boolean          @default(true)
  sourceProducts   SourceProduct[]

  @@unique([sourceId, externalId])
}

model SourceProduct {
  id               String          @id @default(uuid())
  source           Source          @relation(fields: [sourceId], references: [id])
  sourceId         String
  externalId       String
  url              String
  name             String
  sku              String?
  price            Float?
  currency         String?
  stock            Boolean         @default(true)
  images           String[]
  description      String?
  specifications   Json
  product          Product?        @relation(fields: [productId], references: [id])
  productId        String?
  sourceCategory   SourceCategory? @relation(fields: [sourceCategoryId], references: [id])
  sourceCategoryId String?
  /// When the offer first appeared. The oldest offer of a product owns its
  /// card (ProductIdentityService.forExistingProduct); rows older than this
  /// column share one timestamp and fall back to `id` — any stable order will do.
  createdAt        DateTime        @default(now())
  lastSync         DateTime        @default(now())

  @@unique([sourceId, url])
  @@index([productId])
}

model SitemapsThTools {
  id          String    @id @default(uuid())
  url         String    @unique
  isVisited   Boolean   @default(false)
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  lastTriedAt DateTime?
  visitedAt   DateTime?

  @@index([status, visitedAt])
}

model SitemapsDukon {
  id          String    @id @default(uuid())
  url         String    @unique
  isVisited   Boolean   @default(false)
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  lastTriedAt DateTime?
  visitedAt   DateTime?

  @@index([status, visitedAt])
}

model SitemapsToolsBy {
  id          String    @id @default(uuid())
  url         String    @unique
  isVisited   Boolean   @default(false)
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  lastTriedAt DateTime?
  visitedAt   DateTime?

  @@index([status, visitedAt])
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  COURIER
  POST
}

enum PaymentMethod {
  CASH
  CARD
  INVOICE
}

model Order {
  id                 String         @id @default(uuid())
  number             Int            @unique @default(autoincrement())
  status             OrderStatus    @default(NEW)
  /// Set only when the order was placed from a signed-in account — guest
  /// checkout stays the default, so this is null for most rows. It is what
  /// the "История заказов" section of the account lists. Deliberately NOT
  /// matched by phone or e-mail afterwards: anyone could register with
  /// someone else's phone and read their orders.
  user               User?          @relation(fields: [userId], references: [id])
  userId             String?
  customerName       String
  customerPhone      String
  customerEmail      String?
  comment            String?
  deliveryMethod     DeliveryMethod @default(PICKUP)
  deliveryAddress    String?
  paymentMethod      PaymentMethod  @default(CASH)
  /// Who the invoice is made out to — a snapshot taken at checkout, like the
  /// line prices. Reading it through `user` lost it as soon as the company
  /// edited its profile or deleted the account. Null for a private buyer.
  payerType          CustomerType?
  payerName          String?
  /// УНП.
  payerTaxId         String?
  payerAddress       String?
  payerAccount       String?
  payerBankName      String?
  payerBankBic       String?
  /// Where the buyer came from — «yandex / cpc», «google / organic»,
  /// «direct» (attribution/traffic-source.ts, last non-direct touch).
  trafficSource      String?
  /// The very first visit's source (how they found us at all).
  firstTrafficSource String?
  /// Both raw touches (UTM tags, click ids, referrer host, landing page).
  attribution        Json?
  currency           String         @default("BYN")
  itemsTotal         Float          @default(0)
  deliveryCost       Float          @default(0)
  discountTotal      Float          @default(0)
  total              Float          @default(0)
  promoCode          PromoCode?     @relation(fields: [promoCodeId], references: [id])
  promoCodeId        String?
  /// Snapshot of the code as typed, kept readable if the PromoCode is deleted.
  promoCodeLabel     String?
  items              OrderItem[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([payerTaxId])
  @@index([trafficSource, createdAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  product      Product? @relation(fields: [productId], references: [id])
  productId    String?
  productName  String
  productSlug  String
  productSku   String?
  productImage String?
  unitPrice    Float
  /// Pre-discount price at order time, when the product was on sale.
  unitOldPrice Float?
  quantity     Int
  lineTotal    Float

  @@index([orderId])
  @@index([productId])
}

model ParserError {
  id        String   @id @default(uuid())
  url       String
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([url])
}

enum ParserRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model ParserRun {
  id         String          @id @default(uuid())
  key        String
  label      String
  status     ParserRunStatus @default(RUNNING)
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  durationMs Int?
  result     Json?
  error      String?
  // ParserError rows created in this run's time window (loose link by time).
  errorCount Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([key, startedAt])
  @@index([startedAt])
}

model ParserRuntimeStatus {
  id            String    @id @default(uuid())
  key           String    @unique
  label         String
  isRunning     Boolean   @default(false)
  startedAt     DateTime?
  finishedAt    DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  lastResult    Json?
  runs          Int       @default(0)
  successes     Int       @default(0)
  failures      Int       @default(0)
  /// Queued behind its source's lock in the worker («Ждёт окончания батча»);
  /// cleared when the job starts. In the DB because the API renders it.
  waitingSince  DateTime?
  updatedAt     DateTime  @updatedAt
}

enum ParserJobRequestStatus {
  /// Written by the API, not yet seen by the worker.
  PENDING
  /// Claimed by the worker: queued behind the source lock or running.
  TAKEN
  DONE
  FAILED
}

/// A parser job an admin asked for. The API process never parses: it writes
/// the request here, the worker claims it (`ParserJobRequestService`) and runs
/// it under the same per-source lock as the crons, then records the outcome —
/// which is what the synchronous `/admin/queue/*` buttons wait for.
model ParserJobRequest {
  id         String                 @id @default(uuid())
  sourceCode String
  jobName    String
  /// Job parameters, e.g. `{ "limit": 25 }` for a manual batch.
  params     Json?
  status     ParserJobRequestStatus @default(PENDING)
  result     Json?
  error      String?
  createdAt  DateTime               @default(now())
  takenAt    DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
  @@index([sourceCode, status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Guest product review. Every review lands in PENDING and only counts towards
/// the product's rating aggregate once an admin approves it.
model Review {
  id                 String       @id @default(uuid())
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId          String
  /// Set when the review came from a signed-in account. `SetNull` on delete:
  /// a deleted account loses the link, the review and its text stay.
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId             String?
  /// True when, at submission time, the account had a non-cancelled order
  /// containing this product. A stored snapshot, not a live check — the order
  /// history behind it can change, the fact that it was verified cannot.
  isVerifiedPurchase Boolean      @default(false)
  authorName         String
  authorEmail        String?
  rating             Int
  title              String?
  text               String
  status             ReviewStatus @default(PENDING)
  /// Salted hash of the submitter's IP — pseudonymous, used only for
  /// rate-limiting and duplicate detection. The raw address is never stored.
  ipHash             String?
  /// Set when an admin approves or rejects the review.
  moderatedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@index([userId, createdAt])
}

enum PromoCodeType {
  PERCENT
  FIXED
}

/// Checkout discount code. Always re-validated server-side in POST /orders —
/// the client only ever gets a preview of the discount.
model PromoCode {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String?
  type          PromoCodeType @default(PERCENT)
  /// Percent (0..100) when type is PERCENT, absolute currency amount when FIXED.
  value         Float
  minOrderTotal Float?
  /// Null means unlimited.
  maxUses       Int?
  usedCount     Int           @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean       @default(true)
  freeDelivery  Boolean       @default(false)
  /// Listed in the customer's account ("Доступные промокоды"). Turn it off for
  /// a code meant for one person — the code still works, it just stops being
  /// advertised to everyone who signs in.
  isPublic      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]

  @@index([isActive, endsAt])
}

enum PricingScope {
  GLOBAL
  CATEGORY
  BRAND
  SOURCE
}

enum RoundingMode {
  NONE
  INTEGER
  CHARM_90
  CHARM_99
  TENS
}

/// Markup rule turning a supplier cost into the storefront price.
/// The most specific active rule wins: SOURCE > BRAND > CATEGORY > GLOBAL,
/// ties broken by `priority` (higher first).
model PricingRule {
  id            String       @id @default(uuid())
  name          String
  scope         PricingScope @default(GLOBAL)
  category      Category?    @relation(fields: [categoryId], references: [id])
  categoryId    String?
  brand         Brand?       @relation(fields: [brandId], references: [id])
  brandId       String?
  source        Source?      @relation(fields: [sourceId], references: [id])
  sourceId      String?
  /// Cost band the rule applies to; null means unbounded on that side.
  minCost       Float?
  maxCost       Float?
  markupPercent Float        @default(0)
  /// Flat amount added on top of the percentage markup.
  markupFixed   Float        @default(0)
  /// Floor on absolute margin, applied after markup and before rounding.
  minMargin     Float?
  rounding      RoundingMode @default(CHARM_90)
  priority      Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  products      Product[]

  @@index([isActive, scope])
}

enum PricingMode {
  AUTO
  MANUAL
}

/// Audit trail of storefront price changes, used to spot supplier drift and
/// to explain "why is this product priced like that".
model PriceHistory {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  costPrice Float?
  oldPrice  Float?
  newPrice  Float?
  /// Short machine-readable cause: 'rule', 'manual', 'cost_changed', 'blocked_spike'.
  reason    String
  ruleId    String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Slug of a product that was merged away, pointing at the survivor.
/// Lets the storefront 301 instead of 404ing, so merging never costs links.
model ProductRedirect {
  id        String   @id @default(uuid())
  slug      String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@index([productId])
}

/// Promo banner for the home page slider.
/// Images are referenced by URL — there is no upload endpoint, so the admin
/// pastes a link (supplier CDN, own hosting, or an existing product image).
model Banner {
  id         String    @id @default(uuid())
  title      String
  subtitle   String?
  /// Desktop/base image.
  imageUrl   String
  /// Optional narrower crop; falls back to imageUrl when empty.
  mobileUrl  String?
  linkUrl    String?
  buttonText String?
  /// Background behind the image, so letterboxing doesn't look broken.
  bgColor    String?
  order      Int       @default(0)
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive, order])
}

/// Runtime-tunable parser knobs, so an admin can stop or start parsing without
/// a redeploy. A missing row means "fall back to the env variable" — env stays
/// the deploy-time default, the DB row is the operator's override.
model ParserSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Supplier category pages, queued the same way product URLs are. Crawling a
/// category yields product URLs that the sitemap may not list, and `isEnabled`
/// lets an admin drop a whole branch without touching the regex env vars.
model ParserCategoryQueue {
  id             String    @id @default(uuid())
  sourceCode     String
  url            String
  name           String
  /// Slug chain from the supplier URL, so the UI can render a tree.
  path           String[]
  level          Int       @default(0)
  isEnabled      Boolean   @default(true)
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  pagesCrawled   Int       @default(0)
  productsFound  Int       @default(0)
  productsQueued Int       @default(0)
  lastError      String?
  lastTriedAt    DateTime?
  visitedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sourceCode, url])
  @@index([sourceCode, status])
  @@index([sourceCode, level])
}

/// Checkpoint for bounded catalog crawls, independent of operator settings.
model ParserCatalogCrawl {
  sourceCode String   @id
  state      Json
  updatedAt  DateTime @updatedAt
}

/// Old category addresses retained after consolidating the legacy catalog tree.
model CategoryRedirect {
  slug       String   @id
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

/// Different values on duplicate specification keys are retained for review.
model CategoryRepairConflict {
  id                  String   @id
  productId           String
  fromSpecificationId String
  toSpecificationId   String
  value               String
  keptValue           String
  createdAt           DateTime @default(now())
}

enum UserRole {
  CUSTOMER
  ADMIN
}

/// Физическое или юридическое лицо. Chosen at registration; drives what the
/// account has to fill in (a company needs a name to put on an invoice) and is
/// what a future B2B price list would key off.
enum CustomerType {
  INDIVIDUAL
  COMPANY
}

/// Storefront account. Guest checkout stays the default — an account only adds
/// a saved profile and, for ADMIN, access to /admin.
model User {
  id              String       @id @default(uuid())
  /// Normalized (trimmed + lowercased) login — an e-mail works as one. Stored
  /// already normalized so "Admin" and "admin" cannot become two accounts.
  login           String       @unique
  /// scrypt hash with its own salt and parameters — see auth/password.util.ts.
  /// Never selected into anything the API returns.
  passwordHash    String
  role            UserRole     @default(CUSTOMER)
  customerType    CustomerType @default(INDIVIDUAL)
  name            String?
  email           String?
  /// When `email` was proven to belong to the account (link from the
  /// confirmation letter). Reset to null whenever `email` changes.
  emailVerifiedAt DateTime?
  phone           String?
  /// Required for COMPANY accounts (checked in the service, not the schema, so
  /// an admin can still fix a half-filled row).
  companyName     String?
  /// УНП (checksum-validated on input, see common/utils/requisites.ts).
  taxId           String?
  /// Invoice requisites of a COMPANY account — copied into every order it
  /// places (see Order.payer*), so the profile can change afterwards.
  legalAddress    String?
  /// Settlement account, a BY IBAN.
  bankAccount     String?
  bankName        String?
  bankBic         String?
  /// Deactivated accounts keep their orders and sessions history but cannot
  /// log in, and every live session is dropped the moment the flag goes off.
  isActive        Boolean      @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions           UserSession[]
  orders             Order[]
  cartItems          CartItem[]
  listItems          UserListItem[]
  reviews            Review[]
  adminActions       AdminActionLog[]
  emailVerifications EmailVerification[]
  purchaseLists      PurchaseList[]
  leads              Lead[]

  @@index([role])
}

/// A confirmation link sent to `email`. Only the token's SHA-256 is stored, like
/// sessions. Bound to the address it was sent to: if the account's e-mail has
/// changed since, the link confirms nothing.
model EmailVerification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// One login = one row. Tokens are opaque random strings; only their SHA-256
/// is stored, so a database dump cannot be replayed as a session, and deleting
/// the row logs that device out immediately (which a JWT could not do).
model UserSession {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Server-side copy of a signed-in customer's cart, so it survives a new
/// device, a cleared browser or a phone/desktop switch. The client cart in
/// localStorage stays the thing the UI renders (and the only cart a guest
/// has) — this is the backup that is merged into it on sign-in and overwritten
/// from it on every change, i.e. last write wins. Prices are deliberately NOT
/// stored: a line is a product plus a quantity, and the price is read from
/// `Product` every time the cart is served.
model CartItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Cascade: a product an admin deletes cannot stay in anyone's cart.
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([updatedAt])
  @@index([productId])
}

/// Favourites and comparison are the same thing in storage: a set of products
/// an account picked. They differ only in how many fit (comparison caps at 4,
/// see COMPARE_LIMIT on the storefront) and where they are rendered, so one
/// table with a kind beats two identical ones.
enum UserListKind {
  WISHLIST
  COMPARE
}

model UserListItem {
  id        String       @id @default(uuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Cascade: a product an admin deletes cannot stay in anyone's list.
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  kind      UserListKind
  createdAt DateTime     @default(now())

  @@unique([userId, kind, productId])
  @@index([userId, kind])
  @@index([createdAt])
  @@index([productId])
}

/// Who changed what in the admin panel.
///
/// Worth having only now that admins are accounts: under the shared
/// `ADMIN_TOKEN` there was no "who" to record. Mutating requests are logged by
/// `AdminActionLogInterceptor` — reads are not, or the log would be mostly
/// dashboard polling.
/// Errors worth looking at after the fact: every 5xx, plus the client errors an
/// admin screen got back when its request should have worked. The container log
/// has the same information but scrolls away and is not reachable from the
/// panel, which is where someone notices that something is broken.
///
/// Bounded two ways: `ERROR_LOG_TTL_DAYS` (30) prunes old rows, and a repeat of
/// the same failure within a short window bumps `occurrences` instead of
/// inserting — one broken endpoint under load must not write a row per request.
model ErrorLog {
  id          String   @id @default(uuid())
  statusCode  Int
  method      String
  path        String
  /// Exception class name: BadRequestException, PrismaClientKnownRequestError…
  kind        String
  message     String
  /// Validation errors arrive as a list of sentences; kept as sent, truncated.
  detail      Json?
  /// 5xx only — a client error's stack says nothing the path does not.
  stack       String?
  /// Request body with secrets redacted and the whole thing truncated, exactly
  /// like the audit trail: evidence of what was sent, not a replayable payload.
  payload     Json?
  /// Who was making the request, when that is known: an admin login, the
  /// `x-admin-token` service path, or null for an anonymous visitor.
  actorLabel  String?
  ip          String?
  userAgent   String?
  /// How many times this same failure repeated inside the dedupe window.
  occurrences Int      @default(1)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode, createdAt])
  @@index([lastSeenAt])
  @@index([statusCode, lastSeenAt])
}

model AdminActionLog {
  id         String   @id @default(uuid())
  /// Null for a call that authenticated with the `x-admin-token` service
  /// header (runbook curl, CI), which has no account behind it.
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  /// The login as it was at the time, so a deleted or renamed account still
  /// reads correctly here. "x-admin-token" for the service path.
  actorLabel String
  method     String
  path       String
  statusCode Int
  /// Request body, with secrets redacted and the whole thing truncated — it is
  /// evidence of what changed, not a replayable payload.
  payload    Json?
  /// Stored in the clear, unlike `Review.ipHash`: the actor is already
  /// identified by name, so "from where" is the only thing an audit adds, and
  /// a hash would answer nothing.
  ip         String?
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([path])
}

enum AiEntity {
  PRODUCT
  CATEGORY
}

enum AiTaskStatus {
  /// Waiting for `scheduledAt`; the runner picks it up then.
  QUEUED
  RUNNING
  /// Stopped by an admin; resumes from the remaining PENDING items.
  PAUSED
  DONE
  CANCELLED
}

enum AiTaskItemStatus {
  PENDING
  /// The answer changed at least one field and it was written.
  APPLIED
  /// The answer matched what was already there.
  UNCHANGED
  FAILED
  /// An admin rolled the change back.
  REVERTED
}

/// Reusable instruction for an AI task. The task keeps its own copy of the
/// text, so editing a prompt never rewrites what an old task did.
model AiPrompt {
  id        String   @id @default(uuid())
  name      String
  entity    AiEntity
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     AiTask[]

  @@index([entity])
}

model AiTask {
  id               String       @id @default(uuid())
  name             String
  entity           AiEntity
  status           AiTaskStatus @default(QUEUED)
  /// Field names the model may rewrite (see `ai/ai-fields.ts`).
  fields           String[]
  prompt           AiPrompt?    @relation(fields: [promptId], references: [id], onDelete: SetNull)
  promptId         String?
  /// Snapshot of the instruction at creation time.
  promptText       String
  model            String
  /// Entities per model request — the free tier counts requests, not tokens.
  batchSize        Int          @default(5)
  scheduledAt      DateTime     @default(now())
  /// Set on a 429: the runner leaves the task alone until then.
  pausedUntil      DateTime?
  lastError        String?
  total            Int          @default(0)
  processed        Int          @default(0)
  applied          Int          @default(0)
  failed           Int          @default(0)
  /// Tokens the model billed for this task (all batches, previews excluded).
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  /// Part of promptTokens served from the provider's cache (cheaper).
  cacheHitTokens   Int          @default(0)
  createdBy        String?
  createdAt        DateTime     @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  items            AiTaskItem[]

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model AiTaskItem {
  id         String           @id @default(uuid())
  task       AiTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  /// Product or category id — not a foreign key, so deleting a product keeps
  /// the task history readable.
  entityId   String
  entityName String
  status     AiTaskItemStatus @default(PENDING)
  attempts   Int              @default(0)
  /// `{ field: { old, new } }` for every field the answer changed.
  changes    Json?
  /// The model's raw answer for this entity, for debugging a prompt.
  response   Json?
  /// `{ field: reason }` — what `ai-validate.ts` refused to write.
  rejected   Json?
  /// `{ key: note }` — written, but worth a look (a text near-identical to a
  /// sibling variant's).
  warnings   Json?
  error      String?
  updatedAt  DateTime         @updatedAt

  @@unique([taskId, entityId])
  @@index([taskId, status])
}

/// Site-wide settings an admin edits at runtime (`seller.*`: the shop's own
/// requisites printed on invoices and quotes). Key/value like ParserSetting,
/// read through SellerService with code defaults behind it.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum LeadKind {
  /// A commercial offer downloaded from the cart.
  QUOTE
  /// «Уточнить наличие / подобрать аналог» on a product, or the contact form
  /// on the page for organisations.
  QUESTION
}

enum LeadStatus {
  NEW
  IN_WORK
  DONE
  REJECTED
}

/// A request from a would-be customer that is not an order yet. Orders have
/// their own table; this is what a manager calls back on.
model Lead {
  id                 String     @id @default(uuid())
  number             Int        @unique @default(autoincrement())
  kind               LeadKind
  status             LeadStatus @default(NEW)
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId             String?
  companyName        String?
  /// УНП.
  taxId              String?
  contactName        String?
  phone              String?
  email              String?
  message            String?
  /// The product a question is about (snapshot name kept if it is deleted).
  productId          String?
  productName        String?
  productSlug        String?
  /// Quote lines as priced when the quote was made: [{productId, name, slug,
  /// sku, quantity, unitPrice, lineTotal}].
  items              Json?
  total              Float?
  currency           String?
  /// Salted hash of the requester's IP, for the per-IP limit — never the IP.
  ipHash             String?
  /// Same as Order: last non-direct source, first source, raw touches.
  trafficSource      String?
  firstTrafficSource String?
  attribution        Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}

/// A named list of regular purchases («расходники на месяц»). Stores only
/// product ids and quantities — names and prices are read from Product every
/// time, the same rule as the stored cart.
model PurchaseList {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  /// [{productId, quantity}]
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Product and category URLs whose text changed, waiting to be announced to
/// Yandex through IndexNow (`seo/indexnow.service.ts`). A row is deleted once
/// the ping is accepted.
model IndexNowUrl {
  url       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}
