// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native","debian-openssl-1.1.x","debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Category {
  id             String   @id @default(uuid())
  name           String
  /// Public URL segment. Pretty and short where possible, so it is NOT a
  /// reliable identity — two suppliers' branches can both end in "Прочее".
  slug           String   @unique
  /// Identity: the full slug chain from the root ("aksessuary/avtolampy/narva").
  /// Parsers upsert on this, which is what keeps same-named leaves under
  /// different parents from collapsing into one category.
  pathKey        String   @unique
  parentId       String?
  level          Int
  path           String[]
  description    String?
  image          String?
  seoTitle       String
  seoDescription String

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products               Product[]
  specifications         Specification[]
  mappedSourceCategories SourceCategory[] @relation("MappedSourceCategory")
  redirects              CategoryRedirect[]
  pricingRules           PricingRule[]

  @@index([parentId])
}

model Brand {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  description    String?
  logo           String?
  country        String?
  seoTitle       String
  seoDescription String
  products       Product[]
  pricingRules   PricingRule[]
}

model Specification {
  id           String                 @id @default(uuid())
  name         String
  key          String
  categoryId   String
  category     Category               @relation(fields: [categoryId], references: [id])
  unit         String?
  group        String?
  filterable   Boolean                @default(false)
  productSpecs ProductSpecification[]

  @@unique([categoryId, key])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

model Product {
  id               String                 @id @default(uuid())
  slug             String                 @unique
  name             String
  brand            Brand?                 @relation(fields: [brandId], references: [id])
  brandId          String?
  category         Category               @relation(fields: [categoryId], references: [id])
  categoryId       String
  sku              String?
  barcode          String?
  model            String?
  images           ProductImage[]
  priceValue       Float?
  priceCurrency    String?
  oldPrice         Float?
  /// Supplier cost the storefront price is derived from.
  costPrice        Float?
  /// AUTO — recomputed from PricingRule on every parse. MANUAL — an admin set
  /// the price by hand and parsing must not overwrite it.
  pricingMode      PricingMode            @default(AUTO)
  appliedRule      PricingRule?           @relation(fields: [appliedRuleId], references: [id])
  appliedRuleId    String?
  /// Set when a cost jump looked like a supplier error; the old price is kept
  /// until an admin confirms.
  priceReviewNeeded Boolean               @default(false)
  priceHistory     PriceHistory[]
  stockStatus      String?
  stockQuantity    Int?
  status           ProductStatus          @default(PUBLISHED)
  descriptionShort String?
  descriptionFull  String?
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  productSpecs     ProductSpecification[]
  sourceProducts   SourceProduct[]
  orderItems       OrderItem[]
  reviews          Review[]
  redirects        ProductRedirect[]
  /// Denormalized aggregate over APPROVED reviews, recomputed on moderation.
  ratingAvg        Float?
  ratingCount      Int                    @default(0)
  /// Normalized dedup keys, rebuilt whenever identity fields change. Matching
  /// looks these up directly instead of re-normalizing the whole catalogue.
  matchBarcode     String?
  /// brand + sku, normalized.
  matchSku         String?
  /// brand + model, normalized.
  matchModel       String?

  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, priceValue])
  @@index([status, createdAt])
  @@index([status, name])
  @@index([status, ratingAvg])
  @@index([priceReviewNeeded])
  @@index([matchBarcode])
  @@index([matchSku])
  @@index([matchModel])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
}

model ProductSpecification {
  id              String        @id @default(uuid())
  product         Product       @relation(fields: [productId], references: [id])
  productId       String
  specification   Specification @relation(fields: [specificationId], references: [id])
  specificationId String
  value           String

  @@unique([productId, specificationId])
  @@index([specificationId])
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  alt       String?
  order     Int
  product   Product @relation(fields: [productId], references: [id])
  productId String
}

model Source {
  id               String           @id @default(uuid())
  name             String
  code             String           @unique
  url              String
  sourceProducts   SourceProduct[]
  sourceCategories SourceCategory[]
  pricingRules     PricingRule[]
}

model SourceCategory {
  id               String           @id @default(uuid())
  source           Source           @relation(fields: [sourceId], references: [id])
  sourceId         String
  externalId       String
  name             String
  slug             String
  url              String?
  parent           SourceCategory?  @relation("SourceCategoryChildren", fields: [parentId], references: [id])
  parentId         String?
  children         SourceCategory[] @relation("SourceCategoryChildren")
  level            Int
  path             String[]
  mappedCategory   Category?        @relation("MappedSourceCategory", fields: [mappedCategoryId], references: [id])
  mappedCategoryId String?
  /// Off means "do not import products from this branch" — checked against the
  /// breadcrumb chain before a product is saved, so it also covers children.
  isEnabled        Boolean          @default(true)
  sourceProducts   SourceProduct[]

  @@unique([sourceId, externalId])
}

model SourceProduct {
  id             String   @id @default(uuid())
  source         Source   @relation(fields: [sourceId], references: [id])
  sourceId       String
  externalId     String
  url            String
  name           String
  sku            String?
  price          Float?
  currency       String?
  stock          Boolean  @default(true)
  images         String[]
  description    String?
  specifications Json
  product        Product? @relation(fields: [productId], references: [id])
  productId      String?
  sourceCategory SourceCategory? @relation(fields: [sourceCategoryId], references: [id])
  sourceCategoryId String?
  lastSync       DateTime @default(now())

  @@unique([sourceId, url])
}

model SitemapsThTools {
  id          String    @id @default(uuid())
  url         String    @unique
  isVisited   Boolean   @default(false)
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  lastTriedAt DateTime?
  visitedAt   DateTime?
}

model SitemapsDukon {
  id          String    @id @default(uuid())
  url         String    @unique
  isVisited   Boolean   @default(false)
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  lastTriedAt DateTime?
  visitedAt   DateTime?
}

model Sitemaps7745 {
  id          String    @id @default(uuid())
  url         String    @unique
  isVisited   Boolean   @default(false)
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  lastTriedAt DateTime?
  visitedAt   DateTime?
}

model SitemapsToolsBy {
  id          String    @id @default(uuid())
  url         String    @unique
  isVisited   Boolean   @default(false)
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  lastTriedAt DateTime?
  visitedAt   DateTime?
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  COURIER
  POST
}

enum PaymentMethod {
  CASH
  CARD
  INVOICE
}

model Order {
  id             String         @id @default(uuid())
  number         Int            @unique @default(autoincrement())
  status         OrderStatus    @default(NEW)
  customerName   String
  customerPhone  String
  customerEmail  String?
  comment        String?
  deliveryMethod DeliveryMethod @default(PICKUP)
  deliveryAddress String?
  paymentMethod  PaymentMethod  @default(CASH)
  currency       String         @default("BYN")
  itemsTotal     Float          @default(0)
  deliveryCost   Float          @default(0)
  discountTotal  Float          @default(0)
  total          Float          @default(0)
  promoCode      PromoCode?     @relation(fields: [promoCodeId], references: [id])
  promoCodeId    String?
  /// Snapshot of the code as typed, kept readable if the PromoCode is deleted.
  promoCodeLabel String?
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
  productName String
  productSlug String
  productSku  String?
  productImage String?
  unitPrice   Float
  /// Pre-discount price at order time, when the product was on sale.
  unitOldPrice Float?
  quantity    Int
  lineTotal   Float

  @@index([orderId])
}

model ParserError {
  id        String   @id @default(uuid())
  url       String
  message   String
  stack     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([url])
}

enum ParserRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model ParserRun {
  id         String          @id @default(uuid())
  key        String
  label      String
  status     ParserRunStatus @default(RUNNING)
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  durationMs Int?
  result     Json?
  error      String?
  // ParserError rows created in this run's time window (loose link by time).
  errorCount Int             @default(0)
  createdAt  DateTime        @default(now())

  @@index([key, startedAt])
  @@index([startedAt])
}

model ParserRuntimeStatus {
  id            String   @id @default(uuid())
  key           String   @unique
  label         String
  isRunning     Boolean  @default(false)
  startedAt     DateTime?
  finishedAt    DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  lastResult    Json?
  runs          Int      @default(0)
  successes     Int      @default(0)
  failures      Int      @default(0)
  updatedAt     DateTime @updatedAt
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Guest product review. Every review lands in PENDING and only counts towards
/// the product's rating aggregate once an admin approves it.
model Review {
  id          String       @id @default(uuid())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  authorName  String
  authorEmail String?
  rating      Int
  title       String?
  text        String
  status      ReviewStatus @default(PENDING)
  /// Salted hash of the submitter's IP — pseudonymous, used only for
  /// rate-limiting and duplicate detection. The raw address is never stored.
  ipHash      String?
  /// Set when an admin approves or rejects the review.
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

enum PromoCodeType {
  PERCENT
  FIXED
}

/// Checkout discount code. Always re-validated server-side in POST /orders —
/// the client only ever gets a preview of the discount.
model PromoCode {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String?
  type          PromoCodeType @default(PERCENT)
  /// Percent (0..100) when type is PERCENT, absolute currency amount when FIXED.
  value         Float
  minOrderTotal Float?
  /// Null means unlimited.
  maxUses       Int?
  usedCount     Int           @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean       @default(true)
  freeDelivery  Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]

  @@index([isActive, endsAt])
}

enum PricingScope {
  GLOBAL
  CATEGORY
  BRAND
  SOURCE
}

enum RoundingMode {
  NONE
  INTEGER
  CHARM_90
  CHARM_99
  TENS
}

/// Markup rule turning a supplier cost into the storefront price.
/// The most specific active rule wins: SOURCE > BRAND > CATEGORY > GLOBAL,
/// ties broken by `priority` (higher first).
model PricingRule {
  id            String       @id @default(uuid())
  name          String
  scope         PricingScope @default(GLOBAL)
  category      Category?    @relation(fields: [categoryId], references: [id])
  categoryId    String?
  brand         Brand?       @relation(fields: [brandId], references: [id])
  brandId       String?
  source        Source?      @relation(fields: [sourceId], references: [id])
  sourceId      String?
  /// Cost band the rule applies to; null means unbounded on that side.
  minCost       Float?
  maxCost       Float?
  markupPercent Float        @default(0)
  /// Flat amount added on top of the percentage markup.
  markupFixed   Float        @default(0)
  /// Floor on absolute margin, applied after markup and before rounding.
  minMargin     Float?
  rounding      RoundingMode @default(CHARM_90)
  priority      Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  products      Product[]

  @@index([isActive, scope])
}

enum PricingMode {
  AUTO
  MANUAL
}

/// Audit trail of storefront price changes, used to spot supplier drift and
/// to explain "why is this product priced like that".
model PriceHistory {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  costPrice Float?
  oldPrice  Float?
  newPrice  Float?
  /// Short machine-readable cause: 'rule', 'manual', 'cost_changed', 'blocked_spike'.
  reason    String
  ruleId    String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Slug of a product that was merged away, pointing at the survivor.
/// Lets the storefront 301 instead of 404ing, so merging never costs links.
model ProductRedirect {
  id        String   @id @default(uuid())
  slug      String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@index([productId])
}

/// Promo banner for the home page slider.
/// Images are referenced by URL — there is no upload endpoint, so the admin
/// pastes a link (supplier CDN, own hosting, or an existing product image).
model Banner {
  id         String    @id @default(uuid())
  title      String
  subtitle   String?
  /// Desktop/base image.
  imageUrl   String
  /// Optional narrower crop; falls back to imageUrl when empty.
  mobileUrl  String?
  linkUrl    String?
  buttonText String?
  /// Background behind the image, so letterboxing doesn't look broken.
  bgColor    String?
  order      Int       @default(0)
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isActive, order])
}

/// Runtime-tunable parser knobs, so an admin can stop or start parsing without
/// a redeploy. A missing row means "fall back to the env variable" — env stays
/// the deploy-time default, the DB row is the operator's override.
model ParserSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Supplier category pages, queued the same way product URLs are. Crawling a
/// category yields product URLs that the sitemap may not list, and `isEnabled`
/// lets an admin drop a whole branch without touching the regex env vars.
model ParserCategoryQueue {
  id             String    @id @default(uuid())
  sourceCode     String
  url            String
  name           String
  /// Slug chain from the supplier URL, so the UI can render a tree.
  path           String[]
  level          Int       @default(0)
  isEnabled      Boolean   @default(true)
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  pagesCrawled   Int       @default(0)
  productsFound  Int       @default(0)
  productsQueued Int       @default(0)
  lastError      String?
  lastTriedAt    DateTime?
  visitedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sourceCode, url])
  @@index([sourceCode, status])
  @@index([sourceCode, level])
}

/// Checkpoint for bounded catalog crawls, independent of operator settings.
model ParserCatalogCrawl {
  sourceCode String   @id
  state      Json
  updatedAt  DateTime @updatedAt
}

/// Old category addresses retained after consolidating the legacy catalog tree.
model CategoryRedirect {
  slug       String   @id
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

/// Different values on duplicate specification keys are retained for review.
model CategoryRepairConflict {
  id                    String   @id
  productId             String
  fromSpecificationId   String
  toSpecificationId     String
  value                 String
  keptValue             String
  createdAt             DateTime @default(now())
}
