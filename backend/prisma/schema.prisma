generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  login     String?  @unique
  name      String?
  surname   String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SourceWebsite {
  id          String   @id @default(uuid())
  name        String
  baseUrl     String   @unique
  isActive    Boolean  @default(true)
  parserConfig Json?   // Parser-specific configuration (selectors, headers, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  products    Product[]
  categories  Category[]
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  sourceWebsiteId String?
  sourceWebsite SourceWebsite? @relation(fields: [sourceWebsiteId], references: [id])
  depth       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  products    Product[]
  facetFilters FacetFilter[]
}

model FacetFilter {
  id          String   @id @default(uuid())
  name        String   // Display name (e.g., "Цена", "Бренд", "Мощность")
  field       String   // Product field to filter by (e.g., "price", "brand", "specifications.power")
  type        FilterType
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  config      Json?    // Additional config (min/max for ranges, options for selects, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum FilterType {
  RANGE       // For numeric ranges (price, weight, power)
  SELECT      // For single/multi select (brand, color, material)
  BOOLEAN     // For yes/no filters
  MULTISELECT // For multiple selections
}

model Product {
  id              String   @id @default(uuid())
  name            String
  slug            String?
  description     String?
  brand           String?
  model           String?
  article         String?  // SKU/Article number
  barcode         String?
  price           Decimal?
  currency        String   @default("BYN")
  oldPrice        Decimal?
  discount        Int?     // Discount percentage
  
  // Availability
  inStock         Boolean  @default(false)
  stockQuantity   Int      @default(0)
  availabilityText String?
  
  // Physical properties
  weight          Decimal? // in kg
  dimensions      Json?    // { length, width, height }
  
  // Classification
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  sourceWebsiteId String?
  sourceWebsite   SourceWebsite? @relation(fields: [sourceWebsiteId], references: [id])
  
  // Source tracking
  sourceUrl       String?
  sourceId        String?  // Original product ID from source
  
  // Media
  images          Json?    // Array of image URLs
  mainImage       String?
  
  // Specifications as key-value pairs
  specifications  Json?    // { "Мощность": "2200 Вт", "Вес": "5.2 кг" }
  
  // Features
  features        String[] // Array of feature strings
  
  // Additional info
  countryOfOrigin String?
  warranty        String?
  manufacturer    String?
  
  // Parsing metadata
  parsedAt        DateTime @default(now())
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([slug])
  @@index([sourceUrl])
  @@index([categoryId])
  @@index([brand])
  @@index([price])
  @@index([inStock])
}
