# Заход по голому IP (или по любому чужому хосту) на 80-й порт.
# Сертификата на IP-адрес нет и быть не может: браузер к IP-литералу не шлёт
# SNI, выбрать сертификат нечем. А автоматический http→https редирект Caddy
# сохраняет исходный хост, поэтому http://87.232.67.114 превращался в
# https://87.232.67.114 и падал с ERR_SSL_PROTOCOL_ERROR — тупик, из которого
# посетителю не выбраться. Отправляем такие запросы на канонический домен.
# По HTTPS вход по IP всё равно не заработает — это ограничение сертификатов,
# а не конфига; блок лечит ровно путь через http://.
# Для самого {$DOMAIN} поведение не меняется: тот же редирект на https,
# который Caddy выдавал автоматически.
http:// {
  redir https://{$DOMAIN}{uri} permanent
}

# www — отдельный сертификат и 301 на канонический адрес, а не второй рабочий
# хост: иначе каждая страница доступна по двум URL и поисковик делит их вес.
www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
  encode zstd gzip

  # Заголовки безопасности ставятся здесь, а не в Nuxt: так они попадают и в
  # ISR/SWR-ответы из кэша Nitro, и в ответы бэкенда, одним списком.
  # CSP держит 'unsafe-inline' для скриптов — Nuxt кладёт payload и
  # гидратацию в инлайн-<script>; без nonce строже не сделать. Всё остальное
  # (connect, frame-ancestors, base-uri, form-action, object) закрыто на себя,
  # так что внедрённый скрипт не может ни отправить токен наружу, ни
  # подгрузить чужой код. img-src открыт на https: — фото товаров и баннеры
  # приходят с доменов поставщиков.
  # Единственное исключение — Яндекс.Метрика (nuxt.config.ts): её скрипт,
  # отправка хитов/вебвизора (connect, в т.ч. wss) и фрейм карты кликов
  # открыты на домены Метрики, и только на них.
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Cross-Origin-Opener-Policy "same-origin"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.by https://mc.yandex.com https://yastatic.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://mc.yandex.ru https://mc.yandex.by https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.by wss://mc.yandex.com https://mc.webvisor.org https://mc.webvisor.com; frame-src 'self' blob: https://mc.yandex.ru https://mc.yandex.by https://mc.yandex.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
    -X-Powered-By
    -Server
  }

  handle /api/* {
    uri strip_prefix /api
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy frontend:3000
  }
}
