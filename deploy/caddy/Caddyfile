# Заход по голому IP (или по любому чужому хосту) на 80-й порт.
# Сертификата на IP-адрес нет и быть не может: браузер к IP-литералу не шлёт
# SNI, выбрать сертификат нечем. А автоматический http→https редирект Caddy
# сохраняет исходный хост, поэтому http://87.232.67.114 превращался в
# https://87.232.67.114 и падал с ERR_SSL_PROTOCOL_ERROR — тупик, из которого
# посетителю не выбраться. Отправляем такие запросы на канонический домен.
# По HTTPS вход по IP всё равно не заработает — это ограничение сертификатов,
# а не конфига; блок лечит ровно путь через http://.
# Для самого {$DOMAIN} поведение не меняется: тот же редирект на https,
# который Caddy выдавал автоматически.
http:// {
  redir https://{$DOMAIN}{uri} permanent
}

# www — отдельный сертификат и 301 на канонический адрес, а не второй рабочий
# хост: иначе каждая страница доступна по двум URL и поисковик делит их вес.
www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
  encode zstd gzip

  # Заголовки безопасности ставятся здесь, а не в Nuxt: так они попадают и в
  # ISR/SWR-ответы из кэша Nitro, и в ответы бэкенда, одним списком.
  # CSP держит 'unsafe-inline' для скриптов — Nuxt кладёт payload и
  # гидратацию в инлайн-<script>; без nonce строже не сделать. Всё остальное
  # (connect, base-uri, form-action, object) закрыто на себя,
  # так что внедрённый скрипт не может ни отправить токен наружу, ни
  # подгрузить чужой код. img-src открыт на https: — фото товаров и баннеры
  # приходят с доменов поставщиков.
  # Исключения — счётчики (nuxt.config.ts, только после согласия на cookie).
  # Яндекс.Метрика: её скрипт, отправка хитов/вебвизора (connect, в т.ч. wss,
  # и blob-воркер) и фрейм карты кликов открыты на домены Метрики; и только
  # её интерфейс может встроить сайт в iframe (frame-ancestors: карта кликов
  # и ссылок открывают страницу внутри metrika.yandex.ru).
  # Google Tag Manager (16.11.2026): GTM, Google Analytics 4 и Google Ads по
  # списку Google для CSP, плюс tagmanager.google.com для режима
  # предпросмотра. Google Ads шлёт конверсии на разные поддомены
  # doubleclick.net (ad., googleads.g., td.) — открыт весь домен; проверено
  # на живом сайте 16.11 по событию securitypolicyviolation.
  # Тег в контейнере GTM для любого другого сервиса браузер
  # заблокирует — его хосты добавляются сюда осознанно.
  header {
    # No includeSubDomains: mail.gost.by is hoster.by's webmail with a
    # *.hoster.by certificate, and a year of forced HTTPS would lock it out.
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Cross-Origin-Opener-Policy "same-origin"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.by https://mc.yandex.com https://yastatic.net https://www.googletagmanager.com https://*.googletagmanager.com https://tagmanager.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://mc.yandex.ru https://mc.yandex.by https://mc.yandex.com wss://mc.yandex.ru wss://mc.yandex.by wss://mc.yandex.com https://mc.webvisor.org https://mc.webvisor.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://www.google.by https://pagead2.googlesyndication.com https://www.googleadservices.com; frame-src 'self' blob: https://mc.yandex.ru https://mc.yandex.by https://mc.yandex.com https://www.googletagmanager.com https://*.doubleclick.net; worker-src 'self' blob:; frame-ancestors 'self' https://metrika.yandex.ru https://metrika.yandex.by https://metrica.yandex.com https://*.webvisor.com; base-uri 'self'; form-action 'self'; object-src 'none'"
    -X-Powered-By
    -Server
  }

  handle /api/* {
    uri strip_prefix /api
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy frontend:3000
  }
}
