DOMAIN=example.com
PUBLIC_ORIGIN=https://example.com

DB_USER=postgres
DB_PASSWORD=change_me_to_a_long_random_password
DB_NAME=construction_tools

# Prisma connection pool. The default (CPU*2+1 = 5 here) is too small for this
# app's query fan-out — raise it rather than letting requests time out waiting.
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=20

ADMIN_TOKEN=change_me_to_a_long_random_admin_token

# --- Accounts / admin sign-in ---
# On first boot, if there is no active ADMIN account, one is created with this
# login and ADMIN_PASSWORD. Leave ADMIN_PASSWORD empty and the committed
# initial password is used instead, so the first login is always known:
# admin / test-111 — change it in /admin/users right after signing in.
# Nothing here ever overwrites an account that already exists.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# How long an account session (Authorization: Bearer) stays valid.
AUTH_SESSION_TTL_DAYS=30
# How long an untouched account cart is kept before the nightly cleanup drops it.
CART_TTL_DAYS=90
# How long untouched favourites/comparison rows are kept.
LIST_TTL_DAYS=365
# How long the admin action log is kept.
ADMIN_LOG_TTL_DAYS=180
PARSER_CRON_ENABLED=false
# Hard timeout (ms) for every parser HTTP request; a hung fetch would stall a cron.
PARSER_FETCH_TIMEOUT_MS=20000
DUKON_CRON_BATCH_LIMIT=30
TH_TOOLS_CRON_BATCH_LIMIT=30
SUPPLIER_7745_CRON_BATCH_LIMIT=30
SUPPLIER_7745_CRON_ENABLED=false
SUPPLIER_7745_CATEGORY_INCLUDE_REGEX=запчаст|инструмент|электроинструмент|оснаст|оборудован|строй|строител|отделоч|крепеж|фурнитур|сантех|климат|электрик|спецодеж|сиз|садовая техника|автотовар
SUPPLIER_7745_CATEGORY_EXCLUDE_REGEX=семена|зоотовары|аквариум|кухон|ванн|космет|спорт|единоборств|эпилятор|яйцевар|наушник|гарнитур
DUKON_DISCOVERY_MAX_PAGES=5000
SWAGGER_ENABLED=false

# Checkout delivery costs (storefront orders). Defaults: courier 15, post 10, pickup 0.
DELIVERY_COST_COURIER=15
DELIVERY_COST_POST=10

# API hardening. Rate limit = THROTTLE_LIMIT requests per THROTTLE_TTL ms per IP.
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
BODY_LIMIT=1mb
# Reverse-proxy hops to trust for the real client IP (Caddy = 1).
TRUST_PROXY_HOPS=1

# Re-read successful supplier snapshots after this many hours (queue capacity applies).
PARSER_REFRESH_AFTER_HOURS=24
